# API Configuration
# Copy this file to .env and update with your values

# Ngrok URL (without /api suffix)
# Get this by running: ngrok http 5000
# Example: https://abc123def456.ngrok-free.app
EXPO_PUBLIC_NGROK_URL=https://your-ngrok-url.ngrok-free.app

# Network IP (fallback when ngrok is not set)
# Find your IP with: ipconfig (Windows) or ifconfig (Mac/Linux)
EXPO_PUBLIC_NETWORK_IP=192.168.1.100
